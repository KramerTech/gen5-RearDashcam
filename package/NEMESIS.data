[nemesis]
version=1.1
id=dashcam
name=Rear Dashcam
type=application,service
package-version=@VERSION@
short-desc=Records the backup camera to a USB drive while driving
depends=media.codecs
os=NEEV23.*
models=neev*
preinstall=scripts/preinstall.sh
preuninstall=scripts/preun.sh

[app.0]
kind=apk
path=app/DashcamPlayer.apk
package=dev.skramer.dashcam.player
component=dev.skramer.dashcam.player/dev.skramer.dashcam.player.MainActivity

[app.1]
kind=apk
path=app/DigitalRearviewMirror.apk
package=dev.skramer.dashcam.mirror
component=dev.skramer.dashcam.mirror/dev.skramer.dashcam.mirror.MainActivity

[service.0]
name=recorder
kind=sh
path=svc/recorder.sh
uid=root
mode=restart

[service.1]
name=watchdog
kind=sh
path=svc/watchdog.sh
uid=root
mode=restart

[service.2]
name=overlay
kind=sh
path=svc/overlay.sh
uid=root
mode=restart
