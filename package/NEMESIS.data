[nemesis]
version=@VERSION@
id=dashcam
name=Rear Dashcam
types=application,service
preinstall=scripts/preinstall.sh
preuninstall=scripts/preun.sh

[app.0]
kind=apk
path=app/DashcamPlayer.apk
package=dev.skramer.dashcam.player
component=dev.skramer.dashcam.player/dev.skramer.dashcam.player.MainActivity

[service.0]
name=recorder
kind=sh
path=svc/recorder.sh
uid=root
mode=restart

[service.1]
name=watchdog
kind=sh
path=svc/watchdog.sh
uid=root
mode=restart

[service.2]
name=overlay
kind=sh
path=svc/overlay.sh
uid=root
mode=restart
