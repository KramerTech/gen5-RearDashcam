<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/button_disabled" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/button_pressed" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="@color/selected" /><stroke android:width="2dp" android:color="@color/footage" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/button" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
