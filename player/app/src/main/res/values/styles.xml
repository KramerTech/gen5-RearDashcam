<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dashcam" parent="android:Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:buttonStyle">@style/Button</item>
        <item name="android:imageButtonStyle">@style/IconButton</item>
    </style>

    <style name="Button" parent="android:Widget.Holo.Button">
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="IconButton" parent="android:Widget.Holo.ImageButton">
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
    </style>
</resources>
