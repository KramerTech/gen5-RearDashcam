<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.GET_TASKS" />
    <application android:allowBackup="false" android:hardwareAccelerated="true" android:icon="@drawable/ic_mirror"
        android:label="Digital Rear View Mirror" android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
